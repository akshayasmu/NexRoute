# Firestore needs NO entry here at all — on Cloud Run it authenticates
# automatically via the service account Cloud Run already runs as.
# For LOCAL testing only, run this once on your laptop instead:
#   gcloud auth application-default login
#
# Everything below is optional — the app runs with these blank, just
# showing DEMO badges instead of LIVE ones.

LTA_ACCOUNT_KEY=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

PORT=8080
